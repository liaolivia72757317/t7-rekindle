<UserControl x:Class="T7.Rekindle.Desktop.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:T7.Rekindle.Desktop.Views">
  <Border Style="{StaticResource PagePanel}" DataContext="{Binding About}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="80" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,12,0,0">
        <views:Icon Kind="info" Width="32" Height="32" Margin="0,0,20,0" /><TextBlock Text="关于" Style="{StaticResource PageTitle}" />
      </StackPanel></Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,24,0,0" Focusable="False">
        <StackPanel>
          <Border Style="{StaticResource Card}" Padding="24">
            <StackPanel>
              <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="116" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Image Source="/T7-Rekindle;component/Resources/Assets/brand/launcher.ico" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                  <TextBlock Text="{Binding ProjectName}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding ProjectDescription}" FontSize="16" Margin="0,16,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,24,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="启动器版本" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Version}" Margin="24,0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="Git 提交" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding ShortHash}" ToolTip="{Binding HashDescription}" Margin="24,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Button Grid.Column="4" Command="{Binding CopyHashCommand}" Style="{StaticResource IconButton}" ToolTip="复制完整 Git 提交" AutomationProperties.Name="复制完整 Git hash" TabIndex="8"><views:Icon Kind="copy" /></Button>
                </Grid>
              </Border>
            </StackPanel>
          </Border>
          <UniformGrid Columns="3" Margin="0,24,0,0">
            <Button Command="{Binding ShowRepositoryCommand}" IsEnabled="{Binding HasRepositoryAddress}" Margin="0,0,8,0" Padding="20" HorizontalContentAlignment="Stretch" AutomationProperties.Name="项目源代码仓库" ToolTip="{Binding RepositoryAddress}" TabIndex="9">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /></Grid.ColumnDefinitions>
                <views:Icon Kind="code" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="项目源代码仓库" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="GitHub" Style="{StaticResource MutedText}" Margin="0,8,0,0" /></StackPanel>
                <views:Icon Grid.Column="2" Kind="external-link" Width="16" Height="16" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Command="{Binding ShowIssuesCommand}" IsEnabled="{Binding HasIssuesAddress}" Margin="4,0,4,0" Padding="20" HorizontalContentAlignment="Stretch" AutomationProperties.Name="问题反馈" ToolTip="{Binding IssuesAddress}" TabIndex="10">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /></Grid.ColumnDefinitions>
                <views:Icon Kind="message" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="问题反馈" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="GitHub Issues" Style="{StaticResource MutedText}" Margin="0,8,0,0" /></StackPanel>
                <views:Icon Grid.Column="2" Kind="external-link" Width="16" Height="16" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button x:Name="EnvironmentInfoButton" Command="{Binding ShowEnvironmentInfoCommand}" Margin="8,0,0,0" Padding="20"
                    HorizontalContentAlignment="Stretch" AutomationProperties.Name="环境信息" ToolTip="CPU、内存、显卡与运行组件 · 支持一键复制" TabIndex="11">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /></Grid.ColumnDefinitions>
                <views:Icon Kind="monitor" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0">
                  <TextBlock Text="环境信息" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="硬件与运行组件" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                </StackPanel>
                <views:Icon Grid.Column="2" Kind="chevron-right" Width="16" Height="16" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </UniformGrid>
          <UniformGrid Columns="2" Margin="0,20,0,0">
            <Button Command="{Binding ShowLicensesCommand}" Margin="0,0,10,0" Padding="24" HorizontalContentAlignment="Stretch" AutomationProperties.Name="开源软件说明" TabIndex="12">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /></Grid.ColumnDefinitions>
                <views:Icon Kind="file-text" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="16,0"><TextBlock Text="开源软件说明" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="项目与第三方组件许可" Style="{StaticResource MutedText}" Margin="0,12,0,0" /></StackPanel>
                <views:Icon Grid.Column="2" Kind="chevron-right" Width="16" Height="16" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Command="{Binding ShowThanksCommand}" Margin="10,0,0,0" Padding="24" HorizontalContentAlignment="Stretch" AutomationProperties.Name="特别感谢" TabIndex="13">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /></Grid.ColumnDefinitions>
                <views:Icon Kind="heart" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="16,0"><TextBlock Text="特别感谢" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="开发、测试与社区贡献" Style="{StaticResource MutedText}" Margin="0,12,0,0" /></StackPanel>
                <views:Icon Grid.Column="2" Kind="chevron-right" Width="16" Height="16" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </UniformGrid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
