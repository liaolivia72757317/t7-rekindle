<UserControl x:Class="T7.Rekindle.Desktop.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:T7.Rekindle.Desktop.Views">
  <UserControl.Resources>
    <Style x:Key="AboutActionCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="20" />
      <Setter Property="MinHeight" Value="88" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="AboutCardTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="AboutCardCaption" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
  </UserControl.Resources>
  <Border Style="{StaticResource PagePanel}" DataContext="{Binding About}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="80" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,12,0,0">
        <views:Icon Kind="info" Width="32" Height="32" Margin="0,0,20,0" /><TextBlock Text="关于" Style="{StaticResource PageTitle}" />
      </StackPanel></Border>
      <ScrollViewer x:Name="AboutScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,24,0,0" Focusable="False">
        <StackPanel x:Name="AboutContent" SizeChanged="OnContentSizeChanged">
          <Border x:Name="ProjectInfoCard" Style="{StaticResource Card}" Padding="24">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Image Source="/T7-Rekindle;component/Resources/Assets/brand/launcher.ico" Width="72" Height="72" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                  <TextBlock Text="{Binding ProjectName}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding ProjectDescription}" FontSize="16" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="24" />
                </StackPanel>
              </Grid>
              <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,12,0,0">
                <WrapPanel>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,0">
                    <TextBlock Text="启动器版本" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Version}" ToolTip="{Binding DisplayVersion}" Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Git 提交" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ShortHash}" ToolTip="{Binding HashDescription}" Margin="12,0" FontSize="14" VerticalAlignment="Center" />
                    <Button Command="{Binding CopyHashCommand}" Style="{StaticResource IconButton}" Width="32" Height="32" MinHeight="32" Padding="6"
                            ToolTip="复制完整 Git 提交" AutomationProperties.Name="复制完整 Git hash" TabIndex="8"><views:Icon Kind="copy" /></Button>
                  </StackPanel>
                </WrapPanel>
              </Border>
            </StackPanel>
          </Border>
          <Grid x:Name="ClientSupportGrid" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Button x:Name="ClientDownloadButton" Grid.RowSpan="2" Command="{Binding ShowClientDownloadCommand}" Style="{StaticResource AboutActionCard}"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="客户端下载" AutomationProperties.HelpText="{Binding Text, ElementName=ClientDownloadDisclaimer}"
                    ToolTip="{Binding ClientDownloadAddress}" TabIndex="9">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                  <Border Width="44" Height="44" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}">
                    <views:Icon Kind="download" Width="24" Height="24" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="客户端下载" Style="{StaticResource AboutCardTitle}" FontSize="20" />
                    <TextBlock Text="Bilibili · 外部页面" Style="{StaticResource AboutCardCaption}" />
                  </StackPanel>
                  <views:Icon Grid.Column="2" Kind="external-link" Width="16" Height="16" VerticalAlignment="Center" />
                </Grid>
                <TextBlock x:Name="ClientDownloadDisclaimer" Style="{StaticResource MutedText}" Margin="0,16,0,0" TextWrapping="Wrap" LineHeight="21"
                           Text="外部页面由第三方维护，客户端及相关素材版权归原权利人所有。本项目仅提供页面链接，请自行确认下载来源与使用授权。" />
              </StackPanel>
            </Button>
            <Button x:Name="EnvironmentInfoButton" Grid.Column="1" Command="{Binding ShowEnvironmentInfoCommand}" Style="{StaticResource AboutActionCard}"
                    Margin="8,0,0,8" AutomationProperties.Name="环境信息" ToolTip="CPU、内存、显卡与运行组件 · 支持一键复制" TabIndex="10">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                <views:Icon Kind="monitor" Width="24" Height="24" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0">
                  <TextBlock Text="环境信息" Style="{StaticResource AboutCardTitle}" />
                  <TextBlock Text="硬件与运行组件" Style="{StaticResource AboutCardCaption}" />
                </StackPanel>
                <views:Icon Grid.Column="2" Kind="chevron-right" Width="16" Height="16" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button x:Name="IssuesButton" Grid.Column="1" Grid.Row="1" Command="{Binding ShowIssuesCommand}" IsEnabled="{Binding HasIssuesAddress}"
                    Style="{StaticResource AboutActionCard}" Margin="8,8,0,0" AutomationProperties.Name="问题反馈" ToolTip="{Binding IssuesAddress}" TabIndex="11">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                <views:Icon Kind="message" Width="24" Height="24" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="问题反馈" Style="{StaticResource AboutCardTitle}" /><TextBlock Text="GitHub Issues" Style="{StaticResource AboutCardCaption}" /></StackPanel>
                <views:Icon Grid.Column="2" Kind="external-link" Width="16" Height="16" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </Grid>
          <UniformGrid x:Name="ProjectLinksGrid" Columns="3" Margin="0,16,0,0">
            <Button x:Name="RepositoryButton" Command="{Binding ShowRepositoryCommand}" IsEnabled="{Binding HasRepositoryAddress}"
                    Style="{StaticResource AboutActionCard}" Margin="0,0,8,0" AutomationProperties.Name="项目源代码仓库" ToolTip="{Binding RepositoryAddress}" TabIndex="12">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                <views:Icon Kind="code" Width="24" Height="24" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="项目源代码仓库" Style="{StaticResource AboutCardTitle}" /><TextBlock Text="GitHub" Style="{StaticResource AboutCardCaption}" /></StackPanel>
                <views:Icon Grid.Column="2" Kind="external-link" Width="16" Height="16" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button x:Name="LicensesButton" Command="{Binding ShowLicensesCommand}" Style="{StaticResource AboutActionCard}"
                    Margin="4,0,4,0" AutomationProperties.Name="开源软件说明" TabIndex="13">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                <views:Icon Kind="file-text" Width="24" Height="24" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="开源软件说明" Style="{StaticResource AboutCardTitle}" /><TextBlock Text="项目与第三方组件许可" Style="{StaticResource AboutCardCaption}" /></StackPanel>
                <views:Icon Grid.Column="2" Kind="chevron-right" Width="16" Height="16" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button x:Name="ThanksButton" Command="{Binding ShowThanksCommand}" Style="{StaticResource AboutActionCard}"
                    Margin="8,0,0,0" AutomationProperties.Name="特别感谢" TabIndex="14">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                <views:Icon Kind="heart" Width="24" Height="24" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="特别感谢" Style="{StaticResource AboutCardTitle}" /><TextBlock Text="开发、测试与社区贡献" Style="{StaticResource AboutCardCaption}" /></StackPanel>
                <views:Icon Grid.Column="2" Kind="chevron-right" Width="16" Height="16" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </UniformGrid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
