<UserControl x:Class="T7.Rekindle.Desktop.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel DataContext="{Binding About}">
    <Border Style="{StaticResource Card}" Padding="22,0" MinHeight="176">
      <StackPanel>
        <Border Padding="0,14" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
          <StackPanel>
            <TextBlock Text="{Binding ProjectName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ProjectDescription}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
            <TextBlock Text="{Binding ProjectStatus}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
          <Grid MinHeight="44">
            <Grid.ColumnDefinitions><ColumnDefinition Width="108" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="启动器版本" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Version}" FontSize="16" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="版本日志" Command="{Binding ShowChangelogCommand}" Style="{StaticResource LinkButton}"
                    AutomationProperties.Name="查看当前版本日志" TabIndex="3" />
          </Grid>
        </Border>
        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
          <Grid MinHeight="44">
            <Grid.ColumnDefinitions><ColumnDefinition Width="108" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Git 提交" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding ShortHash}" FontSize="12" FontFamily="{StaticResource CodeFontFamily}" VerticalAlignment="Center" ToolTip="{Binding HashDescription}" />
            <Button Grid.Column="2" Content="复制完整 hash" Command="{Binding CopyHashCommand}" Style="{StaticResource LinkButton}"
                    AutomationProperties.Name="复制完整 Git hash" TabIndex="4" />
          </Grid>
        </Border>
        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
          <Grid MinHeight="44">
            <Grid.ColumnDefinitions><ColumnDefinition Width="108" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="GitHub" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding RepositoryAddressDisplay}" ToolTip="{Binding RepositoryAddress}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,6,12,6" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="复制" Command="{Binding CopyRepositoryCommand}" IsEnabled="{Binding HasRepositoryAddress}" Style="{StaticResource LinkButton}" Margin="0,0,12,0"
                      AutomationProperties.Name="复制仓库地址" TabIndex="5" />
              <Button Content="访问仓库 ↗" Command="{Binding ShowRepositoryCommand}" IsEnabled="{Binding HasRepositoryAddress}" Style="{StaticResource LinkButton}"
                      AutomationProperties.Name="在浏览器中打开项目仓库" TabIndex="6" />
            </StackPanel>
          </Grid>
        </Border>
        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
          <Grid MinHeight="60">
            <Grid.ColumnDefinitions><ColumnDefinition Width="108" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="下载入口" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="检查更新可直接下载安装版。发布页提供完整产物；CI 构建需登录 GitHub，保留 14 天。" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,6,12,6" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="ReleasePageLink" Content="发布页 ↗" Command="{Binding ShowDownloadCommand}" ToolTip="{Binding DownloadAddress}" Style="{StaticResource LinkButton}" Margin="0,0,12,0"
                      AutomationProperties.Name="在浏览器中打开正式版本发布页" TabIndex="7" />
              <Button x:Name="BuildsPageLink" Content="CI 构建 ↗" Command="{Binding ShowBuildsCommand}" ToolTip="{Binding BuildsAddress}" Style="{StaticResource LinkButton}"
                      AutomationProperties.Name="在浏览器中查看 CI 开发构建" TabIndex="8" />
            </StackPanel>
          </Grid>
        </Border>
        <Grid MinHeight="44">
          <Grid.ColumnDefinitions><ColumnDefinition Width="108" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="问题反馈" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="通过 GitHub Issues 提交问题、复现步骤或建议。" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,6,12,6" />
          <Button x:Name="IssuesPageLink" Grid.Column="2" Content="提交反馈 ↗" Command="{Binding ShowIssuesCommand}" ToolTip="{Binding IssuesAddress}" Style="{StaticResource LinkButton}"
                  AutomationProperties.Name="在浏览器中打开项目 Issues" TabIndex="9" />
        </Grid>
      </StackPanel>
    </Border>
    <Grid Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" MinHeight="112">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Image Width="16" Height="16" Margin="0,0,8,0" Source="/T7-Rekindle;component/Resources/Assets/icons/document-16.png" Stretch="None" />
            <TextBlock Text="开源软件说明" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="本项目代码采用 MIT License；原游戏客户端、资源及第三方组件遵循各自许可。" Style="{StaticResource MutedText}" Margin="0,8,0,12" />
          <Button Content="查看开源软件说明 →" Command="{Binding ShowLicensesCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                  AutomationProperties.Name="查看开源软件说明" TabIndex="10" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" MinHeight="112">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Image Width="16" Height="16" Margin="0,0,8,0" Source="/T7-Rekindle;component/Resources/Assets/icons/heart-16.png" Stretch="None" />
            <TextBlock Text="特别感谢" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="感谢参与开发、测试、反馈与社区支持的贡献者。" Style="{StaticResource MutedText}" Margin="0,8,0,12" />
          <Button Content="查看致谢说明 →" Command="{Binding ShowThanksCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                  AutomationProperties.Name="查看致谢说明" TabIndex="11" />
        </StackPanel>
      </Border>
    </Grid>
  </StackPanel>
</UserControl>
