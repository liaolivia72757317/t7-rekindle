<UserControl x:Class="T7.Rekindle.Desktop.Views.LaunchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock x:Name="NoticeBanner" Text="{Binding NoticeText}" TextWrapping="Wrap" Margin="0,0,0,12" Style="{StaticResource InlineNotice}"
               Visibility="{Binding HasNotice, Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Polite" />
    <Label x:Name="NameLabel" Content="玩家名称" Target="{Binding ElementName=NameInput}" Width="200" Height="26" HorizontalAlignment="Left" Margin="0,0,0,3" VerticalContentAlignment="Center" />
    <Grid SizeChanged="OnNameRowSizeChanged">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="358" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <TextBox x:Name="NameInput" Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding AreSessionFieldsLocked}" HorizontalScrollBarVisibility="Auto"
               MinHeight="44" AutomationProperties.Name="玩家名称" AutomationProperties.HelpText="启动游戏时使用的名称" TabIndex="4">
        <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers>
          <DataTrigger Binding="{Binding ShowPlayerNameError}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" /></DataTrigger>
        </Style.Triggers></Style></TextBox.Style>
      </TextBox>
      <TextBlock x:Name="NameHint" Grid.Column="1" Margin="20,0,0,0" Width="340" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Text="启动游戏时使用的名称" Style="{StaticResource MutedText}" LineHeight="24" />
    </Grid>
    <TextBlock Text="{Binding PlayerNameError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="14" Margin="0,6,0,0"
               Visibility="{Binding ShowPlayerNameError, Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Polite" />

    <Border x:Name="StatusCard" Margin="0,21,0,0" MinHeight="140" Padding="22,18,22,20">
      <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Style.Triggers>
        <DataTrigger Binding="{Binding StatusTone}" Value="Danger"><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding StatusTone}" Value="Warning"><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" /></DataTrigger>
      </Style.Triggers></Style></Border.Style>
      <StackPanel>
        <Grid>
          <TextBlock Text="启动状态" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Content="打开日志目录" Command="{Binding OpenLogsCommand}" HorizontalAlignment="Right" Style="{StaticResource LinkButton}"
                  FontSize="16" AutomationProperties.Name="打开日志目录" TabIndex="5">
            <Button.ContentTemplate><DataTemplate><StackPanel Orientation="Horizontal">
              <Viewbox Width="20" Height="20" Margin="0,0,8,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource FolderGeometry}" Style="{StaticResource ButtonGlyph}" /></Canvas></Viewbox>
              <TextBlock Text="{Binding}" VerticalAlignment="Center" />
            </StackPanel></DataTemplate></Button.ContentTemplate>
          </Button>
        </Grid>
        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Height="42" Width="42" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}" CornerRadius="21">
            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" /><Style.Triggers>
              <DataTrigger Binding="{Binding StatusTone}" Value="Success"><Setter Property="Background" Value="{DynamicResource SuccessTintBrush}" /></DataTrigger>
            </Style.Triggers></Style></Border.Style>
            <Viewbox Width="26" Height="26"><Canvas Width="24" Height="24"><Path x:Name="StatusGraphic" Style="{StaticResource StatusGlyph}" /></Canvas></Viewbox>
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,0,0">
            <TextBlock Text="{Binding StatusText}" FontSize="23" LineHeight="29" FontWeight="Bold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding DiagnosticText}" Style="{StaticResource MutedText}" LineHeight="22" Margin="0,2,0,0" />
            <Button Content="前往游戏设置" Command="{Binding ShowSettingsCommand}" HorizontalAlignment="Left" Margin="0,7,0,0"
                    AutomationProperties.Name="前往游戏设置" TabIndex="6">
              <Button.Style><Style TargetType="Button" BasedOn="{StaticResource LinkButton}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                <DataTrigger Binding="{Binding IsDirectoryValid}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
              </Style.Triggers></Style></Button.Style>
            </Button>
            <ProgressBar Height="3" BorderThickness="0" Margin="0,8,0,0" IsIndeterminate="{Binding ShowProgress}"
                         Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource AccentSoftBrush}"
                         Visibility="{Binding ShowProgress, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="正在处理当前阶段" />
          </StackPanel>
        </Grid>
        <StackPanel Margin="56,12,0,0">
          <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
            <DataTrigger Binding="{Binding HasSessionLog}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
          </Style.Triggers></Style></StackPanel.Style>
          <Button Content="复制诊断信息" Command="{Binding CopyLogsCommand}" Style="{StaticResource LinkButton}"
                  HorizontalAlignment="Left" AutomationProperties.Name="复制诊断信息" TabIndex="8" />
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
