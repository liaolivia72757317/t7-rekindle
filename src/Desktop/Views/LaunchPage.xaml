<UserControl x:Class="T7.Rekindle.Desktop.Views.LaunchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:T7.Rekindle.Desktop.Views" SizeChanged="OnPageSizeChanged">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,0,0,20">
      <StackPanel>
        <Border x:Name="HeroPanel" SizeChanged="OnHeroSizeChanged" Height="384" CornerRadius="8" Background="{DynamicResource PrimaryBrush}" ClipToBounds="True">
          <Grid>
            <Image x:Name="HeroArtwork" Source="/T7-Rekindle;component/Resources/Assets/art/hero-full-2560x1026.png" Stretch="UniformToFill" Visibility="{DynamicResource LauncherArtworkVisibility}"
                   ImageFailed="OnHeroFailed" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
            <Border Background="#16000000" IsHitTestVisible="False" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="64,0,32,0">
              <TextBlock Text="铁骑 · 重燃" FontSize="48" FontWeight="Bold" Foreground="{DynamicResource ButtonForegroundBrush}" />
              <TextBlock Text="T7-Rekindle" FontSize="20" Margin="4,12,0,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,24,0,0" Padding="24,20" MinHeight="136">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,20,0">
              <views:Icon Kind="megaphone" Width="28" Height="28" Foreground="{DynamicResource GoldBrush}" HorizontalAlignment="Center" />
              <TextBlock Text="最新公告" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,0" />
            </StackPanel>
            <Border Grid.Column="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0" Padding="24,0,0,0">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="暂无公告" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="公告发布后将在这里显示。" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="1" MinHeight="214">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="24,12">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
            <views:Icon Kind="user" Width="28" Height="28" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
              <TextBlock Text="玩家名称" FontSize="18" FontWeight="SemiBold" />
              <TextBlock x:Name="SavedPlayerName" Text="{Binding SavedPlayerName}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SavedPlayerName}" Focusable="True" GotKeyboardFocus="OnValueFocused" LostKeyboardFocus="OnValueBlurred" AutomationProperties.Name="已保存玩家名称" />
            </StackPanel>
            <Button Grid.Column="2" Content="修改" Command="{Binding ShowSettingsCommand}" Height="44" VerticalAlignment="Center" AutomationProperties.Name="修改玩家名称" TabIndex="8" />
          </Grid>
          <Border Grid.Row="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
              <views:Icon Kind="folder" Width="28" Height="28" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                <TextBlock Text="游戏目录" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="SavedDirectory" Text="{Binding SavedClientDirectory}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SavedClientDirectory}" Focusable="True" GotKeyboardFocus="OnValueFocused" LostKeyboardFocus="OnValueBlurred" AutomationProperties.Name="已保存游戏目录" />
              </StackPanel>
              <Button Grid.Column="2" Content="修改" Command="{Binding ShowSettingsCommand}" Height="44" VerticalAlignment="Center" AutomationProperties.Name="修改游戏目录" TabIndex="9" />
            </Grid>
          </Border>
        </Grid>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="100" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Button x:Name="LaunchButton" Command="{Binding MainActionCommand}" Style="{StaticResource PrimaryButton}" FontSize="26" AutomationProperties.Name="{Binding MainActionText}" TabIndex="10">
            <StackPanel Orientation="Horizontal">
              <views:Icon Kind="{Binding MainActionIcon}" Width="26" Height="26" Margin="0,0,12,0" RenderTransformOrigin="0.5,0.5">
                <views:Icon.RenderTransform><RotateTransform /></views:Icon.RenderTransform>
                <views:Icon.Style>
                  <Style TargetType="{x:Type views:Icon}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsManagedGameRunning}" Value="True">
                        <DataTrigger.EnterActions>
                          <BeginStoryboard x:Name="RunningIconRotation">
                            <Storyboard RepeatBehavior="Forever">
                              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                               From="0" To="360" Duration="0:0:1" />
                            </Storyboard>
                          </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="RunningIconRotation" /></DataTrigger.ExitActions>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </views:Icon.Style>
              </views:Icon>
              <TextBlock Text="{Binding MainActionText}" />
            </StackPanel>
          </Button>
          <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="4,12,4,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Ellipse Style="{StaticResource StatusDot}" Width="8" Height="8" Margin="0,0,8,0" />
              <TextBlock Text="{Binding StatusText}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <ProgressBar Height="3" Margin="0,8,0,0" Style="{StaticResource BusyProgress}" Visibility="{Binding ShowProgress, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="正在处理当前阶段" />
            <TextBlock Text="{Binding HomeStatusDetail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding HomeStatusDetail}" HorizontalAlignment="Center" FontSize="14" Margin="0,6,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Button Content="查看详情" Command="{Binding ShowDiagnosticsCommand}" Style="{StaticResource LinkButton}" Margin="8,0" Visibility="{Binding HasSessionLog, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="查看启动诊断详情" TabIndex="11" />
              <Button Content="{Binding CancelButtonText}" Command="{Binding CancelCommand}" Style="{StaticResource LinkButton}" Margin="8,0" Visibility="{Binding CanCancel, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="取消当前启动或检查" TabIndex="12" />
              <Button Content="{Binding StopButtonText}" Command="{Binding StopCommand}" Style="{StaticResource LinkButton}" Foreground="{DynamicResource DangerBrush}" Margin="8,0" Visibility="{Binding CanStop, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="结束游戏或重试清理" TabIndex="13" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
