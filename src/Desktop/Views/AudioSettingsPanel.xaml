<UserControl x:Class="T7.Rekindle.Desktop.Views.AudioSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="GameSettingsStyles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary>
  </UserControl.Resources>
  <Border Style="{StaticResource Card}" Padding="24,20">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="声音设置" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,24,0" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="初始化设置" TabIndex="21" Command="{Binding ResetAudioCommand}" Style="{StaticResource LinkButton}" Margin="0,0,16,0" AutomationProperties.Name="初始化声音设置" AutomationProperties.HelpText="恢复默认选项，点击保存设置后生效" />
          <Button Content="撤销修改" TabIndex="22" Command="{Binding RevertAudioCommand}" Style="{StaticResource LinkButton}" Margin="0,0,16,0" AutomationProperties.Name="撤销声音设置修改" />
          <Button x:Name="ApplyAudioButton" TabIndex="23" Content="保存设置" Command="{Binding ApplyAudioCommand}" Style="{StaticResource PrimaryButton}" MinWidth="112" AutomationProperties.Name="保存声音设置" />
        </StackPanel>
      </Grid>
      <TextBlock Text="{Binding AudioStatus}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,16" AutomationProperties.LiveSetting="Polite" />
      <Grid IsEnabled="{Binding CanEditAudio}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="40" /><RowDefinition Height="44" /><RowDefinition Height="40" /></Grid.RowDefinitions>
        <Label Content="背景音乐" Target="{Binding ElementName=MusicEnabled}" Style="{StaticResource GraphicsLabel}" />
        <CheckBox x:Name="MusicEnabled" TabIndex="24" Grid.Column="1" IsChecked="{Binding AudioMusicEnabled}" Style="{StaticResource PreferenceSwitch}" HorizontalAlignment="Left" AutomationProperties.Name="开启背景音乐" />
        <Label Grid.Row="1" Content="音乐音量" Target="{Binding ElementName=MusicVolume}" Style="{StaticResource GraphicsLabel}" />
        <Slider x:Name="MusicVolume" TabIndex="25" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" LargeChange="10" Value="{Binding AudioMusicVolume}" Style="{StaticResource GraphicsSlider}" AutomationProperties.Name="背景音乐音量百分比" />
        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding AudioMusicVolume, StringFormat={}{0:0}%}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        <Label Grid.Row="2" Content="游戏音效" Target="{Binding ElementName=EffectsEnabled}" Style="{StaticResource GraphicsLabel}" />
        <CheckBox x:Name="EffectsEnabled" TabIndex="26" Grid.Row="2" Grid.Column="1" IsChecked="{Binding AudioEffectsEnabled}" Style="{StaticResource PreferenceSwitch}" HorizontalAlignment="Left" AutomationProperties.Name="开启游戏音效" />
        <Label Grid.Row="3" Content="音效音量" Target="{Binding ElementName=EffectsVolume}" Style="{StaticResource GraphicsLabel}" />
        <Slider x:Name="EffectsVolume" TabIndex="27" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" LargeChange="10" Value="{Binding AudioEffectsVolume}" Style="{StaticResource GraphicsSlider}" AutomationProperties.Name="游戏音效音量百分比" />
        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding AudioEffectsVolume, StringFormat={}{0:0}%}" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>
      <TextBlock Text="关闭音乐或音效会保留音量；这里只调整游戏声音，不改变系统音量。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
      <TextBlock Text="{Binding AudioError}" Style="{StaticResource FieldError}" />
    </StackPanel>
  </Border>
</UserControl>
