<Window x:Class="T7.Rekindle.Desktop.Views.RecentNoticesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:T7.Rekindle.Desktop.Views"
        Title="近期提示" Width="640" Height="500" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Icon="/T7-Rekindle;component/Resources/Assets/brand/launcher.ico"
        FontFamily="{StaticResource UiFontFamily}" FontSize="16" Language="zh-CN" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Cycle"
        Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
  <Grid Margin="28" Background="{DynamicResource PanelBackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TextBlock Text="近期提示" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding History}"><ItemsControl.ItemTemplate><DataTemplate>
        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,16">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <views:Icon Kind="{Binding Icon}" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" /><TextBlock Text="{Binding TimeText}" Style="{StaticResource MutedText}" Margin="0,8,0,0" /></StackPanel>
            <Button Grid.Column="2" Content="{Binding ActionText}" Click="OnNoticeAction" Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                    Visibility="{Binding HasAction, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{Binding ActionText}" TabIndex="0" />
          </Grid>
        </Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </ScrollViewer>
    <TextBlock Grid.Row="1" Text="本次会话暂无提示。" Style="{StaticResource MutedText}" x:Name="EmptyState" />
    <Button Grid.Row="2" Content="关闭" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" MinWidth="100" Margin="0,20,0,0" AutomationProperties.Name="关闭近期提示" TabIndex="1" />
  </Grid>
</Window>
