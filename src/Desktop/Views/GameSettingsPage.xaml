<UserControl x:Class="T7R.Desktop.Views.GameSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:views="clr-namespace:T7R.Desktop.Views"
             xmlns:core="clr-namespace:T7R.Core;assembly=T7R.Core"
             xmlns:services="clr-namespace:T7R.Desktop.Services">
  <Border Style="{StaticResource PagePanel}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="80" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,12,0,0"><views:Icon Kind="settings" Width="32" Height="32" Margin="0,0,20,0" /><TextBlock Text="设置" Style="{StaticResource PageTitle}" /></StackPanel>
      </Border>
      <TabControl Grid.Row="1" x:Name="SettingsTabs" SelectedIndex="{Binding SettingsTabIndex}" AutomationProperties.Name="设置分类">
        <TabItem Header="基本设置" AutomationProperties.Name="基本设置">
          <ScrollViewer FontWeight="Normal" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Border Style="{StaticResource Card}" Padding="24" Background="{DynamicResource ControlBackgroundBrush}" VerticalAlignment="Top">
              <StackPanel>
                <Label Content="玩家名称" Target="{Binding ElementName=NameInput}" FontWeight="Normal" FontSize="18" />
                <TextBox x:Name="NameInput" Text="{Binding PlayerName, UpdateSourceTrigger=Explicit}" IsReadOnly="{Binding ArePlayerNameFieldsLocked}"
                         LostKeyboardFocus="OnEditCompleted" PreviewKeyDown="OnEditKeyDown" HorizontalScrollBarVisibility="Auto"
                         AutomationProperties.Name="玩家名称" AutomationProperties.HelpText="{Binding PlayerNameHint}" TabIndex="8">
                  <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers>
                    <DataTrigger Binding="{Binding ShowPlayerNameError}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                  </Style.Triggers></Style></TextBox.Style>
                </TextBox>
                <TextBlock Text="{Binding PlayerNameHint}" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                <TextBlock x:Name="NameError" Text="{Binding NameFieldError}" Style="{StaticResource FieldError}" />
                <Label Content="游戏目录" Target="{Binding ElementName=DirectoryInput}" FontWeight="Normal" FontSize="18" Margin="0,20,0,8" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
                  <TextBox x:Name="DirectoryInput" Text="{Binding ClientDirectory, UpdateSourceTrigger=Explicit}" Margin="0,0,16,0" HorizontalScrollBarVisibility="Auto" TextChanged="OnDirectoryDraftChanged"
                           LostKeyboardFocus="OnEditCompleted" PreviewKeyDown="OnEditKeyDown" IsReadOnly="{Binding AreSessionFieldsLocked}"
                           AutomationProperties.Name="游戏根目录" AutomationProperties.HelpText="选择游戏根目录或其上级目录，自动定位客户端" TabIndex="9">
                    <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers>
                      <DataTrigger Binding="{Binding HasDirectoryError}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                    </Style.Triggers></Style></TextBox.Style>
                  </TextBox>
                  <Button Grid.Column="1" Command="{Binding BrowseCommand}" AutomationProperties.Name="浏览游戏根目录" TabIndex="10">
                    <StackPanel Orientation="Horizontal"><views:Icon Kind="folder-open" Margin="0,0,10,0" /><TextBlock Text="浏览" /></StackPanel>
                  </Button>
                </Grid>
                <TextBlock Text="{Binding DirectoryFieldError}" Style="{StaticResource FieldError}" />
                <TextBlock x:Name="ClientVersion" Text="{Binding ClientVersionText}" Style="{StaticResource MutedText}" Margin="0,12,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="ResourceCheck" Text="{Binding ResourceCheckText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding DirectoryProgressText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="复制完整路径" Command="{Binding CopyDirectoryCommand}" Style="{StaticResource LinkButton}" Margin="12,0" AutomationProperties.Name="复制完整游戏目录" TabIndex="11" />
                  <Button Grid.Column="2" Content="重新检查" Command="{Binding CheckCommand}" Style="{StaticResource LinkButton}" AutomationProperties.Name="重新检查客户端" TabIndex="12" />
                </Grid>
              </StackPanel>
            </Border>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="启动器设置" AutomationProperties.Name="启动器设置">
          <ScrollViewer FontWeight="Normal" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Border Style="{StaticResource Card}" Padding="24,12" VerticalAlignment="Top">
              <StackPanel>
                <Grid MinHeight="116">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                  <TextBlock Text="启动游戏后最小化到托盘" FontSize="18" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0" />
                  <CheckBox Grid.Column="1" IsChecked="{Binding MinimizeToTray}" Style="{StaticResource PreferenceSwitch}" AutomationProperties.Name="启动游戏后最小化到托盘" TabIndex="8" />
                </Grid>
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                  <Grid MinHeight="116">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                    <TextBlock Text="开机时自动启动启动器" FontSize="18" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <CheckBox Grid.Column="1" IsChecked="{Binding StartWithWindows}" Style="{StaticResource PreferenceSwitch}" AutomationProperties.Name="开机时自动启动启动器" TabIndex="9" />
                  </Grid>
                </Border>
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                  <Grid MinHeight="116">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,12,20,12">
                      <Label Content="更新渠道" Target="{Binding ElementName=UpdateChannelSelector}" FontSize="18" FontWeight="Normal" />
                      <TextBlock Text="正式版面向普通玩家；预览版跟踪最新未发布内容。" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding PreviewAccessStatus}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                    <ComboBox x:Name="UpdateChannelSelector" Grid.Column="1" Height="40" VerticalAlignment="Center"
                              SelectedValue="{Binding SelectedUpdateChannel}" SelectedValuePath="Tag" IsEnabled="{Binding CanChangeUpdateChannel}"
                              AutomationProperties.Name="更新渠道" AutomationProperties.HelpText="预览需本机当前用户的7天离线授权；保存后立即检查；检查、下载或安装期间暂时禁用" TabIndex="10">
                      <ComboBoxItem Content="正式版" Tag="{x:Static services:UpdateChannel.Stable}" />
                      <ComboBoxItem Content="预览版" Tag="{x:Static services:UpdateChannel.Preview}" />
                    </ComboBox>
                  </Grid>
                </Border>
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                  <Grid MinHeight="116">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,12,20,12">
                      <Label Content="输出日志等级" Target="{Binding ElementName=LogLevelSelector}" FontSize="18" FontWeight="Normal" />
                      <TextBlock Text="记录所选等级及更严重的日志，保存后立即生效。正式版默认：信息；预览版锁定为调试（DEBUG）。" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="LogLevelSelector" Grid.Column="1" Height="40" VerticalAlignment="Center"
                              SelectedValue="{Binding SelectedLogLevel}" SelectedValuePath="Tag" IsEnabled="{Binding CanChangeLogLevel}"
                              AutomationProperties.Name="输出日志等级" AutomationProperties.HelpText="正式版默认信息；预览版锁定为调试（DEBUG）；记录所选等级及更严重的日志，保存后立即生效" TabIndex="11">
                      <ComboBoxItem Content="调试" Tag="{x:Static core:DiagnosticLogLevel.Debug}" />
                      <ComboBoxItem Content="信息" Tag="{x:Static core:DiagnosticLogLevel.Info}" />
                      <ComboBoxItem Content="警告" Tag="{x:Static core:DiagnosticLogLevel.Warn}" />
                      <ComboBoxItem Content="错误" Tag="{x:Static core:DiagnosticLogLevel.Error}" />
                    </ComboBox>
                  </Grid>
                </Border>
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                  <Grid MinHeight="116">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,12,20,12">
                      <Label Content="界面主题" Target="{Binding ElementName=ThemeSelector}" FontSize="18" FontWeight="Normal" />
                      <TextBlock Text="选择后自动保存并立即生效；系统高对比度优先。" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="ThemeSelector" Grid.Column="1" Height="40" VerticalAlignment="Center"
                              SelectedValue="{Binding DarkTheme}" SelectedValuePath="Tag"
                              AutomationProperties.Name="界面主题" AutomationProperties.HelpText="选择浅色或深色，自动保存并立即生效；启用系统高对比度时优先使用高对比度主题" TabIndex="12">
                      <ComboBoxItem Content="浅色"><ComboBoxItem.Tag><sys:Boolean>False</sys:Boolean></ComboBoxItem.Tag></ComboBoxItem>
                      <ComboBoxItem Content="深色"><ComboBoxItem.Tag><sys:Boolean>True</sys:Boolean></ComboBoxItem.Tag></ComboBoxItem>
                    </ComboBox>
                  </Grid>
                </Border>
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                  <Grid MinHeight="116">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,12,20,12">
                      <TextBlock Text="显示格挡调试几何" FontSize="18" TextWrapping="Wrap" />
                      <TextBlock Text="在游戏内显示格挡区域、攻击扫掠和接触点；仅用于观察，不改变战斗裁决。" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <CheckBox x:Name="GuardDebugSwitch" Grid.Column="1" IsChecked="{Binding ShowGuardDebug}" Style="{StaticResource PreferenceSwitch}"
                              AutomationProperties.Name="显示格挡调试几何" AutomationProperties.HelpText="默认关闭，保存后立即生效" TabIndex="13" />
                  </Grid>
                </Border>
                <TextBlock Text="{Binding PreferenceError}" Style="{StaticResource FieldError}" />
              </StackPanel>
            </Border>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="游戏设置" AutomationProperties.Name="游戏设置">
          <ScrollViewer FontWeight="Normal" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
            <Border Style="{StaticResource Card}" Padding="24,12" VerticalAlignment="Top">
              <StackPanel>
                <Grid MinHeight="116">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                  <TextBlock Text="跳过启动动画" FontSize="18" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0" />
                  <CheckBox x:Name="SkipStartupAnimationSwitch" Grid.Column="1" IsChecked="{Binding SkipStartupAnimation}" Style="{StaticResource PreferenceSwitch}"
                            AutomationProperties.Name="跳过启动动画" AutomationProperties.HelpText="切换后自动保存" TabIndex="8" />
                </Grid>
                <TextBlock Text="{Binding GameSettingsError}" Style="{StaticResource FieldError}" />
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,12">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <Label Content="输出设备" Target="{Binding ElementName=OutputDeviceSelector}" FontSize="18" VerticalAlignment="Center" />
                      <ComboBox x:Name="OutputDeviceSelector" Grid.Column="1" Height="40" ItemsSource="{Binding OutputDevices}"
                                SelectedValuePath="Id" SelectedValue="{Binding SelectedOutputDeviceId}"
                                IsEnabled="{Binding CanChangeOutputDevice}" TabIndex="9" AutomationProperties.Name="游戏输出设备"
                                AutomationProperties.HelpText="选择游戏渲染显卡，自动保存，下次启动游戏生效">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                    </Grid>
                    <TextBlock Text="{Binding OutputDeviceStatus}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding OutputDeviceError}" Style="{StaticResource FieldError}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <views:GraphicsSettingsPanel x:Name="GraphicsPanel" Margin="0,16,0,0" />
            <views:AudioSettingsPanel x:Name="AudioPanel" Margin="0,16,0,0" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
  </Border>
</UserControl>
