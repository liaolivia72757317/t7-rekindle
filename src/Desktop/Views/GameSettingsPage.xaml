<UserControl x:Class="T7.Rekindle.Desktop.Views.GameSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock x:Name="NoticeBanner" Text="{Binding NoticeText}" TextWrapping="Wrap" Margin="0,0,0,12" Style="{StaticResource InlineNotice}"
               Visibility="{Binding HasNotice, Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Polite" />
    <TextBlock Text="游戏设置" FontSize="18" FontWeight="SemiBold" />
    <TextBlock Text="选择游戏根目录或其上级目录，将自动定位客户端。" Style="{StaticResource MutedText}" Margin="0,5,0,17" />
    <Border Style="{StaticResource Card}" MinHeight="124">
      <StackPanel>
        <Label Content="游戏根目录" Target="{Binding ElementName=DirectoryInput}" />
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="106" /></Grid.ColumnDefinitions>
          <TextBox x:Name="DirectoryInput" Text="{Binding ClientDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" HorizontalScrollBarVisibility="Auto"
                   IsReadOnly="{Binding AreSessionFieldsLocked}" ToolTip="{Binding ClientDirectory}"
                   AutomationProperties.Name="游戏根目录" TabIndex="4">
            <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers>
              <DataTrigger Binding="{Binding HasDirectoryError}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" /></DataTrigger>
            </Style.Triggers></Style></TextBox.Style>
          </TextBox>
          <Button Grid.Column="1" Content="浏览…" Command="{Binding BrowseCommand}" AutomationProperties.Name="浏览游戏根目录" TabIndex="5">
            <Button.ContentTemplate><DataTemplate><StackPanel Orientation="Horizontal">
              <Viewbox Width="20" Height="20" Margin="0,0,8,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource FolderGeometry}" Style="{StaticResource ButtonGlyph}" /></Canvas></Viewbox>
              <TextBlock Text="{Binding}" VerticalAlignment="Center" />
            </StackPanel></DataTemplate></Button.ContentTemplate>
          </Button>
        </Grid>
        <Grid Margin="0,5,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="DirectoryStatusSymbol" Text="{Binding DirectorySymbol}" Margin="0,3,5,0">
            <TextBlock.Style><Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirectoryValid}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding HasDirectoryError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
              </Style.Triggers>
            </Style></TextBlock.Style>
          </TextBlock>
          <TextBlock Grid.Column="1" Text="{Binding DirectoryMessage}" Margin="0,3,12,0" AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Style.Triggers>
              <DataTrigger Binding="{Binding HasDirectoryError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
            </Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <Button Grid.Column="2" Content="重新检查" Command="{Binding CheckCommand}" Style="{StaticResource LinkButton}" VerticalAlignment="Top"
                  AutomationProperties.Name="重新检查客户端" TabIndex="6" />
        </Grid>
      </StackPanel>
    </Border>
    <TextBlock Text="启动或运行期间锁定目录；玩家名称在“启动”页填写。" Style="{StaticResource MutedText}" Margin="0,16,0,0" />
  </StackPanel>
</UserControl>
