<UserControl x:Class="T7.Rekindle.Desktop.Views.LauncherUpdatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:T7.Rekindle.Desktop.Views">
  <Border Style="{StaticResource PagePanel}" DataContext="{Binding About}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="80" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="0,0,0,20">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel x:Name="UpdateTitle" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,16,0"><views:Icon Kind="refresh" Width="32" Height="32" Margin="0,0,20,0" /><TextBlock Text="更新" Style="{StaticResource PageTitle}" /></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="CancelDownloadButton" Content="取消下载" Command="{Binding UpdateDownload.CancelDownloadCommand}"
                    Style="{StaticResource {x:Type Button}}" Height="52" MinWidth="112" Margin="0,0,12,0"
                    Visibility="{Binding UpdateDownload.IsDownloading, Converter={StaticResource BoolVisibility}, FallbackValue=Collapsed}"
                    AutomationProperties.Name="取消安装包下载" TabIndex="9" />
            <Button x:Name="UpdateButton" Command="{Binding UpdateActionCommand}" Style="{StaticResource PrimaryButton}" Height="52" MinWidth="172" AutomationProperties.Name="{Binding UpdateButtonText}" TabIndex="8">
              <StackPanel Orientation="Horizontal"><views:Icon Kind="{Binding UpdateButtonIcon}" Margin="0,0,12,0" /><TextBlock Text="{Binding UpdateButtonText}" /></StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <ScrollViewer x:Name="UpdateScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" SizeChanged="OnBodySizeChanged">
      <Grid x:Name="UpdateBody" Height="660">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Border Grid.Row="0" Style="{StaticResource Card}" Background="{DynamicResource WindowBackgroundBrush}" Margin="0,24,0,24" Padding="28" MinHeight="196">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Grid Margin="0,0,24,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <views:Icon Kind="{Binding UpdateIcon}" Width="56" Height="56" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
              <TextBlock Text="{Binding UpdateStatus}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
              <TextBlock Text="{Binding UpdateDescription}" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
              <TextBlock Text="{Binding UpdateChannelText}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
              <ProgressBar Height="3" Margin="0,12,0,0" Style="{StaticResource BusyProgress}" Visibility="{Binding IsCheckingUpdate, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="正在检查启动器更新" />
            </StackPanel>
          </Grid>
          <Border Grid.Column="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0" Padding="28,0,0,0">
            <StackPanel VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal"><views:Icon Kind="file-text" Margin="0,0,12,0" /><TextBlock Text="当前版本" Style="{StaticResource MutedText}" /></StackPanel>
              <TextBlock Text="{Binding DisplayVersion}" FontSize="20" Margin="32,6,0,20" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal"><views:Icon Kind="clock" Margin="0,0,12,0" /><TextBlock Text="最近检测时间" Style="{StaticResource MutedText}" /></StackPanel>
              <TextBlock Text="{Binding LastCheckText}" FontSize="16" Margin="32,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Visibility="{Binding HasNewUpdate, Converter={StaticResource BoolVisibility}}">
            <StackPanel DataContext="{Binding UpdateDownload}">
              <StackPanel x:Name="DownloadProgressPanel" Margin="0,16,0,0" Visibility="{Binding HasProgress, Converter={StaticResource BoolVisibility}}">
                <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Height="8"
                             Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                             AutomationProperties.Name="安装包下载进度" />
                <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" Margin="0,8,0,0" />
              </StackPanel>
              <TextBlock x:Name="DownloadStatus" Text="{Binding StatusText}" Style="{StaticResource MutedText}" Margin="0,10,0,0"
                         Visibility="{Binding HasStatusText, Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Polite" />
              <TextBlock Text="{Binding SourceNotice}" Style="{StaticResource MutedText}" Margin="0,10,0,0"
                         Visibility="{Binding HasSourceNotice, Converter={StaticResource BoolVisibility}}" />
              <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" Margin="0,10,0,0"
                         Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="28" VerticalAlignment="Stretch">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <views:Icon Kind="file-text" Width="24" Height="24" Margin="0,0,16,0" /><TextBlock Text="版本更新日志" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="ChangelogVersion" Text="{Binding UpdateVersion}" Style="{StaticResource MutedText}" Margin="16,3,0,0" />
          </StackPanel>
          <FlowDocumentScrollViewer x:Name="ChangelogViewer" Grid.Row="1" IsToolBarVisible="False" IsSelectionEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                    FontFamily="{StaticResource UiFontFamily}" Foreground="{DynamicResource TextBrush}" AutomationProperties.Name="发布版本更新日志" DataContextChanged="OnChangelogDataContextChanged" />
        </Grid>
      </Border>
      </Grid>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
