<UserControl x:Class="T7.Rekindle.Desktop.Views.ToastHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:T7.Rekindle.Desktop.Views"
             Focusable="False" HorizontalContentAlignment="Stretch">
  <ItemsControl ItemsSource="{Binding Notices.Visible}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="520">
    <ItemsControl.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource Card}" Padding="16,12" MinHeight="56" Margin="0,0,0,10"
              MouseEnter="OnPauseChanged" MouseLeave="OnPauseChanged" IsKeyboardFocusWithinChanged="OnFocusChanged">
        <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12" /></Border.Effect>
        <Grid>
          <Grid.Style><Style TargetType="Grid">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Severity}" Value="Success"><Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
              <DataTrigger Binding="{Binding Severity}" Value="Warning"><Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
              <DataTrigger Binding="{Binding Severity}" Value="Error"><Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
            </Style.Triggers>
          </Style></Grid.Style>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <views:Icon Kind="{Binding Icon}" Margin="0,0,12,0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Loaded="OnMessageLoaded" Text="{Binding Message}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48" VerticalAlignment="Center">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="AutomationProperties.LiveSetting" Value="Polite" /><Style.Triggers><DataTrigger Binding="{Binding Severity}" Value="Error"><Setter Property="AutomationProperties.LiveSetting" Value="Assertive" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <Button Grid.Column="2" Content="{Binding ActionText}" Command="{Binding ActionCommand}" Style="{StaticResource LinkButton}" Margin="16,0,12,0"
                  Visibility="{Binding HasAction, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{Binding ActionText}" TabIndex="0" />
          <Button Grid.Column="3" Command="{Binding CloseCommand}" Style="{StaticResource CaptionButton}" Width="28" Height="28" MinHeight="28" Margin="8,0,0,0" Padding="5"
                  ToolTip="关闭提示" AutomationProperties.Name="关闭提示" TabIndex="1"><views:Icon Kind="x" Width="16" Height="16" /></Button>
        </Grid>
      </Border>
    </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
