<UserControl x:Class="T7.Rekindle.Desktop.Views.MultiplayerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:T7.Rekindle.Desktop.Views"
             IsVisibleChanged="OnIsVisibleChanged">
  <UserControl.Resources>
    <Style x:Key="ConstructionAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinHeight" Value="96" /><Setter Property="Padding" Value="18,16" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </UserControl.Resources>
  <Border Style="{StaticResource PagePanel}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,12,0,20">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <views:Icon Kind="construction" Width="32" Height="32" VerticalAlignment="Center" />
            <TextBlock x:Name="ConstructionTitle" Grid.Column="1" Text="对战 · 功能建设中" ToolTip="对战 · 功能建设中"
                       Style="{StaticResource PageTitle}" Margin="20,0,0,0" TextTrimming="CharacterEllipsis"
                       Focusable="True" KeyboardNavigation.IsTabStop="False" />
          </Grid>
          <TextBlock Text="该模块暂未开放，后续版本将逐步完善。" Style="{StaticResource MutedText}" FontSize="17" Margin="0,12,0,0" />
        </StackPanel>
      </Border>
      <ScrollViewer x:Name="ConstructionScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,22,0,0" Focusable="False">
        <StackPanel>
          <Border x:Name="ConstructionHero" Style="{StaticResource Card}" Padding="0" CornerRadius="8">
            <Grid MinHeight="340">
              <Border x:Name="ConstructionArtwork" CornerRadius="8" IsHitTestVisible="False" Visibility="{DynamicResource LauncherArtworkVisibility}">
                <Border.Background><ImageBrush ImageSource="/T7-Rekindle;component/Resources/Assets/art/launcher-full-2560x1920.png" Stretch="UniformToFill" AlignmentX="Right" /></Border.Background>
              </Border>
              <Border CornerRadius="8" Background="{DynamicResource PanelBackgroundBrush}" IsHitTestVisible="False">
                <Border.OpacityMask><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                  <GradientStop Color="#FFFFFFFF" Offset="0" /><GradientStop Color="#FFFFFFFF" Offset="0.32" />
                  <GradientStop Color="#DDFFFFFF" Offset="0.46" /><GradientStop Color="#00FFFFFF" Offset="0.75" />
                </LinearGradientBrush></Border.OpacityMask>
              </Border>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.48*" /><ColumnDefinition Width="0.52*" /></Grid.ColumnDefinitions>
                <StackPanel Margin="20,28" VerticalAlignment="Center">
                  <Grid Width="150" Height="150" Margin="0,0,0,14">
                    <Ellipse Stroke="{DynamicResource TextBrush}" StrokeThickness="4" Opacity="0.07" />
                    <Ellipse Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Opacity="0.06" Margin="8" />
                    <views:Icon Kind="construction" Width="84" Height="84" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock Text="该功能正在建设中" FontSize="25" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                  <TextBlock Text="当前模块尚未完成开发，敬请期待。" Style="{StaticResource MutedText}" FontSize="16" TextAlignment="Center" Margin="0,10,0,14" />
                  <Border Background="{DynamicResource GoldSoftBrush}" CornerRadius="15" Padding="20,4" HorizontalAlignment="Center">
                    <TextBlock Text="开发中" Foreground="{DynamicResource GoldHoverBrush}" FontSize="15" />
                  </Border>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
          <Grid Margin="0,22,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button x:Name="ConstructionHomeButton" Style="{StaticResource ConstructionAction}" Command="{Binding ShowHomeCommand}" AutomationProperties.Name="返回首页" TabIndex="8">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                <views:Icon Kind="home" Width="24" Height="24" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0">
                  <TextBlock Text="返回首页" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="继续使用已开放功能" Style="{StaticResource MutedText}" FontSize="16" Margin="0,6,0,0" />
                </StackPanel>
                <views:Icon Grid.Column="2" Kind="chevron-right" Width="16" Height="16" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button x:Name="ConstructionFeedbackButton" Grid.Column="2" Style="{StaticResource ConstructionAction}" Command="{Binding About.ShowIssuesCommand}"
                    IsEnabled="{Binding About.HasIssuesAddress}" ToolTip="{Binding About.IssuesAddress}" AutomationProperties.Name="问题反馈" TabIndex="9">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                <views:Icon Kind="message" Width="24" Height="24" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0">
                  <TextBlock Text="问题反馈" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock x:Name="ConstructionFeedbackCaption" FontSize="16" Margin="0,6,0,0">
                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                      <Setter Property="Text" Value="提交建议与想法" />
                      <Style.Triggers><DataTrigger Binding="{Binding About.HasIssuesAddress}" Value="False">
                        <Setter Property="Text" Value="反馈入口暂不可用" />
                      </DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                  </TextBlock>
                </StackPanel>
                <views:Icon Grid.Column="2" Kind="chevron-right" Width="16" Height="16" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button x:Name="ConstructionAboutButton" Grid.Column="4" Style="{StaticResource ConstructionAction}" Command="{Binding ShowAboutCommand}" AutomationProperties.Name="关于项目" TabIndex="10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                <views:Icon Kind="info" Width="24" Height="24" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0">
                  <TextBlock Text="关于项目" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="查看项目说明" Style="{StaticResource MutedText}" FontSize="16" Margin="0,6,0,0" />
                </StackPanel>
                <views:Icon Grid.Column="2" Kind="chevron-right" Width="16" Height="16" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </Grid>
          <Grid Margin="0,38,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0">
              <views:Icon Kind="info" Width="16" Height="16" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
              <TextBlock Text="功能开放后，此处将显示正式页面。" Style="{StaticResource MutedText}" />
            </StackPanel>
            <Border Grid.Column="2" Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
