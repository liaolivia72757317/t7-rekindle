<Window x:Class="T7.Rekindle.Desktop.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="启动器更新" Width="560" Height="420" MinWidth="480" MinHeight="360"
        Icon="/T7-Rekindle;component/Resources/Assets/brand/app-icon-derived.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource UiFontFamily}" FontSize="13"
        Language="zh-CN" TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid Background="{DynamicResource PanelBackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="*" /><RowDefinition Height="64" /></Grid.RowDefinitions>
    <Border Padding="24,16" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
      <TextBlock x:Name="Heading" Text="发现启动器新版本" FontSize="18" FontWeight="SemiBold" />
    </Border>
    <ScrollViewer x:Name="UpdateScroll" Grid.Row="1" Padding="24,20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False" Focusable="False">
      <StackPanel>
        <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,18">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="当前版本" Style="{StaticResource MutedText}" />
              <TextBlock Text="{Binding CurrentVersion}" FontSize="24" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="→" FontSize="22" Foreground="{DynamicResource MutedTextBrush}" Margin="18,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2">
              <TextBlock Text="可用版本" FontSize="12" Foreground="{DynamicResource WarningBrush}" />
              <TextBlock Text="{Binding TargetVersion}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>
        <TextBlock Text="更新摘要" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
        <TextBox x:Name="SummaryText" Text="{Binding Summary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                 TextBlock.LineHeight="22" Background="{DynamicResource PanelBackgroundBrush}" BorderThickness="0" Padding="0" MinHeight="0" AutomationProperties.Name="更新摘要" TabIndex="0" />
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Padding="24,13" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
      <Grid>
        <TextBlock Text="下载地址暂不可用" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
            <MultiDataTrigger><MultiDataTrigger.Conditions>
              <Condition Binding="{Binding IsNewVersion}" Value="True" />
              <Condition Binding="{Binding HasDownloadAddress}" Value="False" />
            </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
          </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="LaterButton" Content="稍后" IsCancel="True" MinWidth="80" Margin="0,0,10,0" AutomationProperties.Name="稍后再更新" TabIndex="1" />
          <Button x:Name="DownloadButton" Content="查看下载地址" Click="OnDownload" Style="{StaticResource PrimaryButton}" MinWidth="116" TabIndex="2"
                  AutomationProperties.Name="查看下载地址" IsEnabled="{Binding HasDownloadAddress}"
                  Visibility="{Binding IsNewVersion, Converter={StaticResource BoolVisibility}}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
