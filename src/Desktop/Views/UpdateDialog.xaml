<Window x:Class="T7.Rekindle.Desktop.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="启动器更新" Width="560" Height="420" MinWidth="480" MinHeight="360"
        Icon="/T7-Rekindle;component/Resources/Assets/brand/app-icon-derived.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource UiFontFamily}" FontSize="13"
        Language="zh-CN" TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid Background="{DynamicResource PanelBackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="*" /><RowDefinition Height="64" /></Grid.RowDefinitions>
    <Border Padding="24,16" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
      <TextBlock x:Name="Heading" Text="{Binding Heading}" FontSize="18" FontWeight="SemiBold" />
    </Border>
    <ScrollViewer x:Name="UpdateScroll" Grid.Row="1" Padding="24,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False" Focusable="False">
      <StackPanel>
        <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,14">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="当前版本" Style="{StaticResource MutedText}" />
              <TextBlock Text="{Binding Info.CurrentVersion}" FontSize="24" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="→" FontSize="22" Foreground="{DynamicResource MutedTextBrush}" Margin="18,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2">
              <TextBlock Text="最新正式版本" FontSize="12" Foreground="{DynamicResource WarningBrush}" />
              <TextBlock Text="{Binding Info.TargetVersion}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>
        <StackPanel x:Name="DownloadProgressPanel" Margin="0,0,0,12"
                    Visibility="{Binding HasProgress, Converter={StaticResource BoolVisibility}}">
          <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Height="8"
                       Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource ControlBackgroundBrush}"
                       BorderBrush="{DynamicResource ControlBorderBrush}"
                       AutomationProperties.Name="安装包下载进度" />
          <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" Margin="0,0,0,10" />
        <TextBlock Text="{Binding SourceNotice}" Style="{StaticResource MutedText}" Margin="0,0,0,10"
                   Visibility="{Binding HasSourceNotice, Converter={StaticResource BoolVisibility}}" />
        <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" Margin="0,0,0,10"
                   AutomationProperties.LiveSetting="Assertive" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}" />
        <TextBlock Text="更新摘要" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
        <TextBox x:Name="SummaryText" Text="{Binding Info.Summary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                 TextBlock.LineHeight="22" Background="{DynamicResource PanelBackgroundBrush}" BorderThickness="0" Padding="0" MinHeight="0" AutomationProperties.Name="更新摘要" TabIndex="0" />
        <TextBlock Text="仅检查正式版本；优先使用更新镜像，网络失败时尝试 GitHub。安装前需由你确认。" Style="{StaticResource MutedText}" Margin="0,12,0,0" />
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Padding="24,13" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
      <Grid>
        <TextBlock Text="下载地址暂不可用" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
            <MultiDataTrigger><MultiDataTrigger.Conditions>
              <Condition Binding="{Binding Info.IsNewVersion}" Value="True" />
              <Condition Binding="{Binding HasPrimaryAction}" Value="False" />
            </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
          </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="LaterButton" Content="{Binding CloseText}" IsCancel="True" IsEnabled="{Binding CanClose}" MinWidth="80" Margin="0,0,10,0"
                  AutomationProperties.Name="关闭更新结果；下载中关闭会取消下载" TabIndex="1" />
          <Button x:Name="CancelDownloadButton" Content="取消下载" Command="{Binding CancelDownloadCommand}" MinWidth="90" Margin="0,0,10,0"
                  Visibility="{Binding IsDownloading, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="取消安装包下载" TabIndex="2" />
          <Button x:Name="DownloadButton" Content="{Binding PrimaryActionText}" Command="{Binding PrimaryCommand}"
                  Style="{StaticResource PrimaryButton}" MinWidth="116" TabIndex="3"
                  AutomationProperties.Name="{Binding PrimaryActionText}" Visibility="{Binding HasPrimaryAction, Converter={StaticResource BoolVisibility}}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
