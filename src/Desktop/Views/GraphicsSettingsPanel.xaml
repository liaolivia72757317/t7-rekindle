<UserControl x:Class="T7.Rekindle.Desktop.Views.GraphicsSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <UserControl.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="GameSettingsStyles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary>
  </UserControl.Resources>
  <Border Style="{StaticResource Card}" Padding="24,20">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="画面设置" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,24,0" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="初始化设置" TabIndex="9" Command="{Binding ResetGraphicsCommand}" Style="{StaticResource LinkButton}" Margin="0,0,16,0" AutomationProperties.Name="初始化画面设置" AutomationProperties.HelpText="恢复默认选项，点击保存设置后生效" />
          <Button Content="撤销修改" TabIndex="10" Command="{Binding RevertGraphicsCommand}" Style="{StaticResource LinkButton}" Margin="0,0,16,0" AutomationProperties.Name="撤销画面设置修改" />
          <Button x:Name="ApplyGraphicsButton" TabIndex="11" Content="保存设置" Command="{Binding ApplyGraphicsCommand}" Style="{StaticResource PrimaryButton}" MinWidth="112" AutomationProperties.Name="保存画面设置" />
        </StackPanel>
      </Grid>
      <TextBlock Text="{Binding GraphicsStatus}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,16" AutomationProperties.LiveSetting="Polite" />
      <Grid IsEnabled="{Binding CanEditGraphics}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="48" /><RowDefinition Height="48" /><RowDefinition Height="72" />
          <RowDefinition Height="56" /><RowDefinition Height="48" /><RowDefinition Height="48" />
          <RowDefinition Height="48" /><RowDefinition Height="48" /><RowDefinition Height="48" />
        </Grid.RowDefinitions>
        <Label Content="分辨率" Target="{Binding ElementName=Resolution}" Style="{StaticResource GraphicsLabel}" />
        <ComboBox x:Name="Resolution" TabIndex="12" Grid.Column="1" Height="36" ItemsSource="{Binding GraphicsResolutions}" SelectedItem="{Binding GraphicsResolution}"
                  AutomationProperties.Name="游戏分辨率" />
        <Label Grid.Row="1" Content="显示模式" Target="{Binding ElementName=FullScreen}" Style="{StaticResource GraphicsLabel}" />
        <ComboBox x:Name="FullScreen" TabIndex="13" Grid.Row="1" Grid.Column="1" Height="36" SelectedValue="{Binding GraphicsFullScreen}" SelectedValuePath="Tag" AutomationProperties.Name="显示模式">
          <ComboBoxItem Content="窗口模式"><ComboBoxItem.Tag><sys:Boolean>False</sys:Boolean></ComboBoxItem.Tag></ComboBoxItem>
          <ComboBoxItem Content="全屏模式"><ComboBoxItem.Tag><sys:Boolean>True</sys:Boolean></ComboBoxItem.Tag></ComboBoxItem>
        </ComboBox>
        <Label Grid.Row="2" Content="画面质量" Target="{Binding ElementName=Quality}" Style="{StaticResource GraphicsLabel}" />
        <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
          <Slider x:Name="Quality" TabIndex="14" Minimum="0" Maximum="4" LargeChange="1" Value="{Binding GraphicsQuality}" Style="{StaticResource GraphicsSlider}" AutomationProperties.Name="画面质量" />
          <UniformGrid Columns="5" Margin="0,3,0,0" IsHitTestVisible="False">
            <TextBlock Text="极低" HorizontalAlignment="Left" /><TextBlock Text="低" HorizontalAlignment="Center" />
            <TextBlock Text="中" HorizontalAlignment="Center" /><TextBlock Text="高" HorizontalAlignment="Center" /><TextBlock Text="极高" HorizontalAlignment="Right" />
          </UniformGrid>
        </StackPanel>
        <Label Grid.Row="3" Content="视野距离" Target="{Binding ElementName=Distance}" Style="{StaticResource GraphicsLabel}" />
        <Grid Grid.Row="3" Grid.Column="1" VerticalAlignment="Center">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
          <Slider x:Name="Distance" TabIndex="15" Minimum="32" Maximum="1024" LargeChange="16" Value="{Binding GraphicsViewDistance}" Style="{StaticResource GraphicsSlider}" AutomationProperties.Name="视野距离" />
          <TextBlock Grid.Column="1" Text="{Binding GraphicsViewDistance}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
        <Label Grid.Row="4" Content="视野雾" Target="{Binding ElementName=Fog}" Style="{StaticResource GraphicsLabel}" />
        <CheckBox x:Name="Fog" TabIndex="16" Grid.Row="4" Grid.Column="1" IsChecked="{Binding GraphicsFog}" Style="{StaticResource PreferenceSwitch}" HorizontalAlignment="Left" AutomationProperties.Name="开启视野雾" />
        <Label Grid.Row="5" Content="死亡物理效果" Target="{Binding ElementName=RagDoll}" Style="{StaticResource GraphicsLabel}" />
        <CheckBox x:Name="RagDoll" TabIndex="17" Grid.Row="5" Grid.Column="1" IsChecked="{Binding GraphicsRagDoll}" Style="{StaticResource PreferenceSwitch}" HorizontalAlignment="Left" AutomationProperties.Name="开启死亡物理效果" />
        <Label Grid.Row="6" Content="垂直同步" Target="{Binding ElementName=VerticalSync}" Style="{StaticResource GraphicsLabel}" />
        <CheckBox x:Name="VerticalSync" TabIndex="18" Grid.Row="6" Grid.Column="1" IsChecked="{Binding GraphicsVerticalSync}" Style="{StaticResource PreferenceSwitch}" HorizontalAlignment="Left" AutomationProperties.Name="开启垂直同步" />
        <Label Grid.Row="7" Content="帧数限制" Target="{Binding ElementName=FrameLimit}" Style="{StaticResource GraphicsLabel}" />
        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
          <CheckBox x:Name="FrameLimit" TabIndex="19" IsChecked="{Binding GraphicsFrameLimit}" Style="{StaticResource PreferenceSwitch}" HorizontalAlignment="Left" AutomationProperties.Name="限制为每秒 60 帧" />
          <TextBlock Text="60 帧 / 关闭时 200 帧" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>
        <Label Grid.Row="8" Content="刀光" Target="{Binding ElementName=Swoosh}" Style="{StaticResource GraphicsLabel}" />
        <ComboBox x:Name="Swoosh" TabIndex="20" Grid.Row="8" Grid.Column="1" Height="36" ItemsSource="{Binding GraphicsSwooshLabels}" SelectedIndex="{Binding GraphicsSwoosh}" AutomationProperties.Name="刀光显示范围" />
      </Grid>
      <TextBlock Text="开启垂直同步时，帧率由游戏的垂直同步控制。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
      <TextBlock Text="{Binding GraphicsError}" Style="{StaticResource FieldError}" />
    </StackPanel>
  </Border>
</UserControl>
