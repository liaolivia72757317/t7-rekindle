<Application x:Class="T7.Rekindle.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary>
          <Visibility x:Key="LauncherArtworkVisibility">Visible</Visibility>
          <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F7F8" />
          <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PrimaryBrush" Color="#324F60" />
          <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#486371" />
          <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#234759" />
          <SolidColorBrush x:Key="TextBrush" Color="#234759" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#536E81" />
          <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ControlBorderBrush" Color="#B8CCD8" />
          <SolidColorBrush x:Key="DividerBrush" Color="#D5E1E8" />
          <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="HoverBrush" Color="#EDF3F7" />
          <SolidColorBrush x:Key="DisabledBrush" Color="#E7EDF0" />
          <SolidColorBrush x:Key="DisabledTextBrush" Color="#617785" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#27785A" />
          <SolidColorBrush x:Key="SuccessTintBrush" Color="#EAF3EF" />
          <SolidColorBrush x:Key="DangerBrush" Color="#A4443E" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#A4443E" />
          <SolidColorBrush x:Key="WarningBrush" Color="#90621E" />
          <SolidColorBrush x:Key="GoldBrush" Color="#B48A46" />
          <SolidColorBrush x:Key="GoldHoverBrush" Color="#90621E" />
          <SolidColorBrush x:Key="GoldSoftBrush" Color="#E8DFC9" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8DFC9" />
          <SolidColorBrush x:Key="FocusBrush" Color="#90621E" />
          <SolidColorBrush x:Key="LinkBrush" Color="#324F60" />
          <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#7C8996" />
          <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#526779" />
        </ResourceDictionary>
        <ResourceDictionary Source="Resources/Icons.xaml" />
        <ResourceDictionary Source="Resources/Controls.xaml" />
        <ResourceDictionary Source="Resources/Navigation.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
