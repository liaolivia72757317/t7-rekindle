<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:T7.Rekindle.Desktop.Views">
  <Style x:Key="SidebarItem" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontSize" Value="20" /><Setter Property="Height" Value="60" />
    <Setter Property="Margin" Value="16,4,16,4" /><Setter Property="Padding" Value="22,0,12,0" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Border x:Name="Selection" Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <views:Icon Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="24" Height="24" Margin="0,0,18,0" />
          <ContentPresenter VerticalAlignment="Center" />
        </StackPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selection" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Selection" Property="Background" Value="{DynamicResource GoldSoftBrush}" /><Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource GoldBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" /><Setter Property="Padding" Value="8" />
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
  </Style>
  <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
    <Setter Property="Margin" Value="6,0" />
  </Style>
  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="28" /><Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="PagePanel" TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="Padding" Value="36,28" />
  </Style>
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
      <Grid KeyboardNavigation.TabNavigation="Local">
        <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"><TabPanel IsItemsHost="True" /></Border>
        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" Margin="0,24,0,0" TextElement.FontWeight="Normal" />
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem">
    <Setter Property="Height" Value="64" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /><Setter Property="FontSize" Value="20" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
      <Grid Background="Transparent" Margin="24,0,12,0">
        <ContentPresenter ContentSource="Header" Margin="16,0" VerticalAlignment="Center" />
        <Border x:Name="Underline" Height="3" CornerRadius="1" VerticalAlignment="Bottom" Background="Transparent" />
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="FontWeight" Value="SemiBold" />
        <Setter TargetName="Underline" Property="Background" Value="{DynamicResource GoldBrush}" />
      </Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PreferenceSwitch" TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Border x:Name="Track" Width="60" Height="32" CornerRadius="16" Background="{DynamicResource DisabledBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
        <Ellipse x:Name="Thumb" Width="24" Height="24" Fill="{DynamicResource PanelBackgroundBrush}" Margin="3" HorizontalAlignment="Left" />
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryBrush}" /><Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource ButtonForegroundBrush}" /><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FieldError" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /><Setter Property="Margin" Value="0,6,0,0" />
    <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
    <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="BusyProgress" TargetType="ProgressBar">
    <Setter Property="IsIndeterminate" Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" /><Setter Property="FontSize" Value="16" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid>
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" /></ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False" />
        <views:Icon Kind="chevron-down" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
          <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
            <ScrollViewer MaxHeight="300"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
          </Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" /></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="FontSize" Value="16" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <StackPanel Orientation="Horizontal" Background="Transparent">
        <Border Width="20" Height="20" BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="3" Margin="0,0,8,0">
          <views:Icon x:Name="Check" Kind="check" Width="16" Height="16" Visibility="Collapsed" />
        </Border>
        <ContentPresenter VerticalAlignment="Center" />
      </StackPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
