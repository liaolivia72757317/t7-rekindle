<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="CapsuleFontFamily">Consolas, Cascadia Mono, SFMono-Regular, Liberation Mono, Microsoft YaHei UI</FontFamily>
  <LinearGradientBrush x:Key="CapsuleStableBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#3B5C6A" Offset="0" /><GradientStop Color="#2E4C58" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="CapsulePreviewBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F6EFDF" Offset="0" /><GradientStop Color="#EADEC4" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="CapsuleStableText" Color="#FAF9F3" />
  <SolidColorBrush x:Key="CapsuleStableBorder" Color="#7E9198" />
  <SolidColorBrush x:Key="CapsuleStablePlate" Color="#506F7A" />
  <SolidColorBrush x:Key="CapsuleStableStroke" Color="#E9F0F1" />
  <SolidColorBrush x:Key="CapsuleStableHighlight" Color="#29FFFFFF" />
  <SolidColorBrush x:Key="CapsulePreviewText" Color="#294A57" />
  <SolidColorBrush x:Key="CapsulePreviewBorder" Color="#B69761" />
  <SolidColorBrush x:Key="CapsulePreviewPlate" Color="#DFC99D" />
  <SolidColorBrush x:Key="CapsulePreviewStroke" Color="#6A4D20" />
  <SolidColorBrush x:Key="CapsulePreviewHighlight" Color="#B8FFFFFF" />
  <LinearGradientBrush x:Key="CapsuleUpdateBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#EBBC61" Offset="0" /><GradientStop Color="#DBA33D" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="CapsuleUpdateText" Color="#422B0D" />
  <SolidColorBrush x:Key="CapsuleUpdateBorder" Color="#9F702B" />
  <SolidColorBrush x:Key="CapsuleUpdateHighlight" Color="#FFE0A0" />
  <SolidColorBrush x:Key="CapsuleFocusBrush" Color="#B69761" />
  <!-- Lucide shield-check / flask-conical, ISC; see THIRD-PARTY-NOTICES.txt. -->
  <Geometry x:Key="CapsuleStableIcon">M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z M9 12l2 2 4-4</Geometry>
  <Geometry x:Key="CapsulePreviewIcon">M14 2v6a2 2 0 0 0 .245.96l5.51 10.08A2 2 0 0 1 18 22H6a2 2 0 0 1-1.755-2.96l5.51-10.08A2 2 0 0 0 10 8V2 M6.453 15h11.094 M8.5 2h7</Geometry>
  <Style x:Key="CapsuleKeyboardFocus">
    <Setter Property="Control.Template"><Setter.Value><ControlTemplate>
      <Border Margin="3,11,3,-5" CornerRadius="23" BorderThickness="2" BorderBrush="{DynamicResource CapsuleFocusBrush}" />
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="VersionCapsuleButton" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Height" Value="52" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource CapsuleStableText}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource CapsuleKeyboardFocus}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid Background="Transparent"><ContentPresenter /></Grid>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding About.IsPreviewBuild}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource CapsulePreviewText}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="CapsuleBodyStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6,0,10,0" />
    <Setter Property="Background" Value="{DynamicResource CapsuleStableBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CapsuleStableBorder}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding About.IsPreviewBuild}" Value="True">
        <Setter Property="Background" Value="{DynamicResource CapsulePreviewBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CapsulePreviewBorder}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="CapsuleHighlightStyle" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource CapsuleStableHighlight}" />
    <Style.Triggers><DataTrigger Binding="{Binding About.IsPreviewBuild}" Value="True">
      <Setter Property="BorderBrush" Value="{DynamicResource CapsulePreviewHighlight}" />
    </DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="CapsulePlateStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CapsuleStablePlate}" />
    <Style.Triggers><DataTrigger Binding="{Binding About.IsPreviewBuild}" Value="True">
      <Setter Property="Background" Value="{DynamicResource CapsulePreviewPlate}" />
    </DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="CapsuleIconStyle" TargetType="Path">
    <Setter Property="Data" Value="{StaticResource CapsuleStableIcon}" />
    <Setter Property="Stroke" Value="{DynamicResource CapsuleStableStroke}" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Style.Triggers><DataTrigger Binding="{Binding About.IsPreviewBuild}" Value="True">
      <Setter Property="Data" Value="{StaticResource CapsulePreviewIcon}" />
      <Setter Property="Stroke" Value="{DynamicResource CapsulePreviewStroke}" />
    </DataTrigger></Style.Triggers>
  </Style>
</ResourceDictionary>
