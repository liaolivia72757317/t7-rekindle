<Project>
  <Import Project="..\..\Managed.Common.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>0.1.0</Version>
    <Version Condition="'$(T7_RELEASE_VERSION)' != ''">$(T7_RELEASE_VERSION)</Version>
    <AssemblyVersion Condition="'$(T7_RELEASE_VERSION)' != ''">$(T7_RELEASE_VERSION)</AssemblyVersion>
    <FileVersion Condition="'$(T7_RELEASE_VERSION)' != ''">$(T7_RELEASE_VERSION)</FileVersion>
    <Product>铁骑·重燃（T7-Rekindle）</Product>
    <Description>铁骑·重燃是一个独立开源项目，目标是重新实现《刀锋铁骑》的服务端，让玩家通过原版客户端重回熟悉的战场。我们希望先完成本地人机对战，再逐步支持局域网联机。&#xA;项目不以营利为目的，欢迎开发者和玩家一起参与。</Description>
    <RepositoryUrl>https://github.com/liaolivia72757317/t7-rekindle</RepositoryUrl>
    <SourceRevisionId Condition="'$(GITHUB_SHA)' != ''">$(GITHUB_SHA)</SourceRevisionId>
    <RootNamespace>T7.Rekindle.Desktop</RootNamespace>
    <AssemblyName>T7-Rekindle</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\Assets\brand\launcher.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>7.3</LangVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
    <AssemblyMetadata Include="DownloadUrl" Value="$(RepositoryUrl)/releases" />
    <AssemblyMetadata Include="BuildsUrl" Value="$(RepositoryUrl)/actions/workflows/ci.yml" />
    <AssemblyMetadata Include="IssuesUrl" Value="$(RepositoryUrl)/issues" />
    <AssemblyMetadata Include="UpdateBaseUrl" Value="$(T7_UPDATE_BASE_URL)" />
    <Resource Include="Resources\Assets\**\*" Exclude="Resources\Assets\icons\**\*;Resources\Assets\art\scene-complete.png" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(SourceRevisionId)' != ''">
      <_Parameter1>CommitHash</_Parameter1>
      <_Parameter2>$(SourceRevisionId)</_Parameter2>
    </AssemblyAttribute>
    <EmbeddedResource Include="$(RepositoryRoot)LICENSE" LogicalName="T7.Rekindle.Documents.LICENSE" />
    <EmbeddedResource Include="$(RepositoryRoot)THIRD-PARTY.txt" LogicalName="T7.Rekindle.Documents.THIRD-PARTY.txt" />
    <EmbeddedResource Include="Resources\CHANGELOG.md" LogicalName="T7.Rekindle.Documents.CHANGELOG.md" />
    <EmbeddedResource Include="Resources\THANKS.md" LogicalName="T7.Rekindle.Documents.THANKS.md" />
    <EmbeddedResource Include="Resources\THIRD-PARTY-NOTICES.txt" LogicalName="T7.Rekindle.Documents.THIRD-PARTY-NOTICES.txt" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>T7.ManagedHarness</_Parameter1>
    </AssemblyAttribute>
    <None Update="NLog.config" CopyToOutputDirectory="PreserveNewest" />
    <Page Update="Resources\Theme.Dark.xaml" />
    <Page Update="Resources\Theme.HighContrast.xaml" />
    <ProjectReference Include="..\Core\T7.Core.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="[8.4.2]" ExcludeAssets="analyzers" />
    <PackageReference Include="Newtonsoft.Json" Version="[13.0.4]" />
    <PackageReference Include="NLog" Version="[6.2.1]" />
  </ItemGroup>
  <Target Name="CopyNativeBridge" AfterTargets="Build">
    <Copy SourceFiles="$(RepositoryRoot)artifacts\native\bin\$(PlatformTarget)\$(Configuration)\T7.NativeBridge.dll"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(RepositoryRoot)artifacts\native\bin\$(PlatformTarget)\$(Configuration)\T7.NativeBridge.dll')" />
  </Target>
  <Import Project="BusinessScripts.targets" />
  <Import Project="..\..\Managed.Common.targets" />
</Project>
