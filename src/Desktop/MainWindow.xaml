<Window x:Class="T7.Rekindle.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:T7.Rekindle.Desktop.Views"
        Title="T7-Rekindle" Icon="/T7-Rekindle;component/Resources/Assets/brand/app-icon-derived.ico"
        AutomationProperties.Name="T7-Rekindle 本地客户端启动器"
        Width="800" Height="600" MinWidth="720" MinHeight="560"
        FontFamily="{StaticResource UiFontFamily}" FontSize="13" Language="zh-CN"
        TextOptions.TextFormattingMode="Display" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen" Closing="OnClosing" Closed="OnClosed">
  <Grid Background="{DynamicResource WindowBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="108" />
      <RowDefinition Height="32" />
      <RowDefinition Height="*" />
      <RowDefinition Height="80" />
    </Grid.RowDefinitions>

    <Image Grid.Row="0" Grid.RowSpan="3" Source="/T7-Rekindle;component/Resources/Assets/art/battlefield-light-reconstructed.png"
           Stretch="UniformToFill" StretchDirection="Both" Opacity="0.52" IsHitTestVisible="False" Focusable="False"
           SnapsToDevicePixels="True">
      <Image.Style><Style TargetType="Image"><Style.Triggers>
        <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
      </Style.Triggers></Style></Image.Style>
    </Image>

    <Border Grid.Row="0" Background="Transparent" Padding="24,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="148" /></Grid.ColumnDefinitions>
        <Image x:Name="BrandLogo" Width="288" Height="80" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0"
               Source="/T7-Rekindle;component/Resources/Assets/brand/logo-horizontal.png" Stretch="Uniform" StretchDirection="DownOnly"
               AutomationProperties.Name="T7-Rekindle 国风品牌标识" ImageFailed="OnBrandLogoFailed" />
        <TextBlock x:Name="BrandFallback" Text="T7-Rekindle" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,24,0,0"
                   Visibility="Collapsed" AutomationProperties.Name="T7-Rekindle" />
        <TextBlock Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,0,2" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                   AutomationProperties.Name="构建信息" ToolTip="{Binding About.HashDescription}">
          <TextBlock.Inlines>
            <Run Text="本地客户端启动器 · " />
            <Run Text="{Binding About.Version, Mode=OneWay}" />
            <Run Text=" · " />
            <Run Text="提交 " />
            <Run Text="{Binding About.ShortHash, Mode=OneWay}" />
          </TextBlock.Inlines>
        </TextBlock>
        <StackPanel Grid.Column="1" Width="148" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,0,0">
          <Button Content="{Binding About.UpdateButtonText}" Command="{Binding About.CheckUpdateCommand}" Height="36" Padding="8,4"
                  AutomationProperties.Name="检查启动器更新" TabIndex="0">
            <Button.ContentTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Width="16" Height="16" Margin="0,0,7,0" Source="/T7-Rekindle;component/Resources/Assets/icons/refresh-16.png" Stretch="None" /><TextBlock Text="{Binding}" VerticalAlignment="Center" /></StackPanel></DataTemplate></Button.ContentTemplate>
          </Button>
          <TextBlock Text="{Binding About.UpdateStatus}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0"
                     HorizontalAlignment="Left" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="Transparent" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="24,0">
      <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Local">
        <RadioButton Content="启动" GroupName="Pages" IsChecked="{Binding IsHomeSelected}" Style="{StaticResource NavigationTab}"
                     AutomationProperties.Name="启动页" TabIndex="1" />
        <RadioButton Content="游戏设置" GroupName="Pages" IsChecked="{Binding IsSettingsSelected}" Style="{StaticResource NavigationTab}"
                     AutomationProperties.Name="游戏设置页" TabIndex="2" />
        <RadioButton Content="关于" GroupName="Pages" IsChecked="{Binding IsAboutSelected}" Style="{StaticResource NavigationTab}"
                     AutomationProperties.Name="关于页" TabIndex="3" />
      </StackPanel>
    </Border>

    <ScrollViewer x:Name="PageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="24,24,24,12" Focusable="False" CanContentScroll="False">
      <Grid>
        <views:LaunchPage Visibility="{Binding IsHomeSelected, Converter={StaticResource BoolVisibility}}" />
        <views:GameSettingsPage Visibility="{Binding IsSettingsSelected, Converter={StaticResource BoolVisibility}}" />
        <views:AboutPage Visibility="{Binding IsAboutSelected, Converter={StaticResource BoolVisibility}}" />
      </Grid>
    </ScrollViewer>

    <Border Grid.Row="3" Padding="24,15" Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Margin="0,0,8,0" Style="{StaticResource StatusDot}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            <Button Content="查看状态" Command="{Binding ShowHomeCommand}" Margin="12,0,0,0"
                    AutomationProperties.Name="查看启动状态" TabIndex="20">
              <Button.Style><Style TargetType="Button" BasedOn="{StaticResource LinkButton}"><Style.Triggers>
                <DataTrigger Binding="{Binding IsHomeSelected}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
              </Style.Triggers></Style></Button.Style>
            </Button>
          </StackPanel>
          <TextBlock x:Name="FooterFeedback" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="430"
                     AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
              <Setter Property="Text" Value="{Binding SettingsFeedback}" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsAboutSelected}" Value="True" />
                    <Condition Binding="{Binding About.HasFeedback}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Text" Value="{Binding About.Feedback}" />
                  <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style></TextBlock.Style>
          </TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="{Binding CancelButtonText}" Command="{Binding CancelCommand}" Margin="0,0,10,0"
                  Visibility="{Binding CanCancel, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="取消启动或检查" TabIndex="21" />
          <Button Content="{Binding StopButtonText}" Command="{Binding StopCommand}" Margin="0,0,10,0" Foreground="{DynamicResource DangerBrush}"
                  Visibility="{Binding CanStop, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="结束游戏或重试清理" TabIndex="22" />
          <Button x:Name="LaunchButton" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}"
                  MinWidth="148" Width="148" Height="43" IsDefault="True" AutomationProperties.Name="启动游戏" TabIndex="23">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Viewbox Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center">
                <Path Data="M2,1 L14,8 L2,15 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
              </Viewbox>
              <TextBlock Text="{Binding MainActionText}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
